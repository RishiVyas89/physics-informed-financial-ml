Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rv5", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"t", "-", "4"}], ";;", "t"}], "]"}], "]"}], "^", "2"}], 
       "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "5", ",", 
       RowBox[{"Length", "[", "r", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rv5Dates", "=", 
    RowBox[{"rDates", "[", 
     RowBox[{"[", 
      RowBox[{"5", ";;"}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "rv5", "]"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"rv5Dates", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", 
   RowBox[{"rDates", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "5"}], "]"}], "]"}]}], "}"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rv5", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "5"}], "]"}], "]"}], "^", "2"}], "]"}], "]"}]}], 
   "}"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"Mean", "[", 
       RowBox[{"rv5", "^", "2"}], "]"}], "/", "5"}], "]"}], ",", "sd"}], 
   "}"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Min", "[", "rv5", "]"}], ",", 
   RowBox[{"Median", "[", "rv5", "]"}], ",", 
   RowBox[{"Max", "[", "rv5", "]"}]}], "}"}], "\n", 
 RowBox[{
  RowBox[{"rv5Dates", "[", 
   RowBox[{"[", 
    RowBox[{"First", "@", 
     RowBox[{"Ordering", "[", 
      RowBox[{"rv5", ",", 
       RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"pRV5", "=", 
  RowBox[{"DateListPlot", "[", 
   RowBox[{
    RowBox[{"TimeSeries", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"rv5Dates", ",", "rv5"}], "}"}], "]"}], "]"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{
    "PlotLabel", "->", "\"\<Backward-looking 5-day realized volatility\>\""}],
     ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Date\>\"", ",", "\"\<RV (5-day, not annualized)\>\""}], 
      "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "projectDir", ",", "\"\<results\>\"", ",", "\"\<figures\>\"", ",", 
       "\"\<05_rv5_backward.png\>\""}], "}"}], "]"}], ",", "pRV5"}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.0007186959299073`*^9, 4.000718695930909*^9}},
