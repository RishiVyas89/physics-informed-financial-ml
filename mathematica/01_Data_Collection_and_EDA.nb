Cell[BoxData[{
 RowBox[{
  RowBox[{"header", "=", 
   RowBox[{"First", "[", "raw", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Rest", "[", "raw", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dates", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"DateObject", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<Year\>\"", ",", "\"\<-\>\"", ",", "\"\<Month\>\"", ",", 
           "\"\<-\>\"", ",", "\"\<Day\>\""}], "}"}]}], "}"}], ",", 
       "\"\<Day\>\""}], "]"}], "&"}], "/@", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"2", ";;", "7"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaps", "=", 
    RowBox[{
     RowBox[{"Differences", "[", 
      RowBox[{"AbsoluteTime", "/@", "dates"}], "]"}], "/", "86400"}]}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Trading days\>\"", "->", 
     RowBox[{"Length", "[", "data", "]"}]}], ",", 
    RowBox[{"\"\<First date\>\"", "->", 
     RowBox[{"First", "[", "dates", "]"}]}], ",", 
    RowBox[{"\"\<Last date\>\"", "->", 
     RowBox[{"Last", "[", "dates", "]"}]}], ",", 
    RowBox[{"\"\<Strictly increasing dates\>\"", "->", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"gaps", ",", "Positive"}], "]"}]}], ",", 
    RowBox[{"\"\<Duplicate dates\>\"", "->", 
     RowBox[{
      RowBox[{"Length", "[", "dates", "]"}], "-", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", "dates", "]"}], "]"}]}]}], ",", 
    RowBox[{"\"\<Non-numeric values\>\"", "->", 
     RowBox[{"Count", "[", 
      RowBox[{"values", ",", 
       RowBox[{"x_", "/;", 
        RowBox[{"!", 
         RowBox[{"NumericQ", "[", "x", "]"}]}]}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ",", 
    RowBox[{"\"\<Prices <= 0\>\"", "->", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"values", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"1", ";;", "5"}]}], "]"}], "]"}], ",", 
       RowBox[{"x_", "/;", 
        RowBox[{"x", "<=", "0"}]}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ",", 
    RowBox[{"\"\<Zero-volume days\>\"", "->", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"values", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "6"}], "]"}], "]"}], ",", "0"}], "]"}]}], ",", 
    RowBox[{"\"\<OHLC violations\>\"", "->", 
     RowBox[{"Count", "[", 
      RowBox[{"values", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"o_", ",", "h_", ",", "l_", ",", "c_", ",", "_", ",", "_"}], 
         "}"}], "/;", 
        RowBox[{"!", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"l", "<=", 
            RowBox[{"Min", "[", 
             RowBox[{"o", ",", "c"}], "]"}]}], "&&", 
           RowBox[{"h", ">=", 
            RowBox[{"Max", "[", 
             RowBox[{"o", ",", "c"}], "]"}]}]}], ")"}]}]}]}], "]"}]}], ",", 
    RowBox[{"\"\<Close != Adj Close\>\"", "->", 
     RowBox[{"Count", "[", 
      RowBox[{"values", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"_", ",", "_", ",", "_", ",", "c_", ",", "a_", ",", "_"}], 
         "}"}], "/;", 
        RowBox[{"c", "!=", "a"}]}]}], "]"}]}], ",", 
    RowBox[{"\"\<Calendar gaps {days, count}\>\"", "->", 
     RowBox[{"Sort", "[", 
      RowBox[{"Tally", "[", "gaps", "]"}], "]"}]}]}], "|>"}], "]"}]}], "Input",
