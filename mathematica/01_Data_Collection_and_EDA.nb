Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mu", "=", 
    RowBox[{"Mean", "[", "r", "]"}]}], ";", 
   RowBox[{"sd", "=", 
    RowBox[{"StandardDeviation", "[", "r", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Skewness", "[", "r", "]"}], ",", 
    RowBox[{"Kurtosis", "[", "r", "]"}]}], "}"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", "-", "mu"}], ")"}], "/", "sd"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{"z", ",", 
      RowBox[{"x_", "/;", 
       RowBox[{
        RowBox[{"Abs", "[", "x", "]"}], ">", "4"}]}]}], "]"}], ",", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Length", "[", "r", "]"}], "*", "2", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"CDF", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", "]"}], ",", "4"}], "]"}]}], 
       ")"}]}], "]"}]}], "}"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bins", ",", "dens"}], "}"}], "=", 
   RowBox[{"HistogramList", "[", 
    RowBox[{"r", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.14"}], ",", "0.10", ",", "0.004"}], "}"}], ",", 
     "\"\<PDF\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"MovingAverage", "[", 
         RowBox[{"bins", ",", "2"}], "]"}], ",", "dens"}], "}"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"pDist", "=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListLogPlot", "[", 
      RowBox[{"pts", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"PointSize", "[", "Medium", "]"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Empirical\>\"", "}"}]}]}], "]"}], ",", 
     RowBox[{"LogPlot", "[", 
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"mu", ",", "sd"}], "]"}], ",", "x"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"mu", "-", 
          RowBox[{"4.5", " ", "sd"}]}], ",", 
         RowBox[{"mu", "+", 
          RowBox[{"4.5", " ", "sd"}]}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Red"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Gaussian (same mean, SD)\>\"", "}"}]}]}], "]"}], 
     ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"ImageSize", "->", "Large"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Daily log return\>\"", ",", 
        "\"\<Probability density (log scale)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Return distribution vs Gaussian\>\""}]}],
     "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"band", "=", 
   RowBox[{"1.96", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Length", "[", "r", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pACF", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Rest", "[", 
        RowBox[{"CorrelationFunction", "[", 
         RowBox[{"r", ",", 
          RowBox[{"{", "20", "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"Rest", "[", 
        RowBox[{"CorrelationFunction", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "r", "]"}], ",", 
          RowBox[{"{", "20", "}"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"DataRange", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "20"}], "}"}]}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<r (direction)\>\"", ",", "\"\<|r| (size)\>\""}], "}"}]}], 
     ",", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "band"}], ",", "band"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"ImageSize", "->", "Large"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Lag (trading days)\>\"", ",", "\"\<Autocorrelation\>\""}],
        "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Autocorrelation of returns vs absolute returns\>\""}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "projectDir", ",", "\"\<results\>\"", ",", "\"\<figures\>\"", ",", 
       "\"\<03_return_distribution.png\>\""}], "}"}], "]"}], ",", "pDist"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "projectDir", ",", "\"\<results\>\"", ",", "\"\<figures\>\"", ",", 
       "\"\<04_acf_returns_vs_abs.png\>\""}], "}"}], "]"}], ",", "pACF"}], 
   "]"}], ";"}]}], "Input",
