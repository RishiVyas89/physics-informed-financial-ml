    RowBox[{"Total", "[", "r", "]"}], ",", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"Last", "[", 
       RowBox[{"close", "[", "\"\<Values\>\"", "]"}], "]"}], "/", 
