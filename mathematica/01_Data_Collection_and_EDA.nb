    RowBox[{"First", "[", "rDates", "]"}], ",", 
    RowBox[{"First", "[", "r", "]"}], ",", 
    RowBox[{"Log", "[", 
     RowBox[{"1332.87", "/", "1332.41"}], "]"}]}], "}"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
