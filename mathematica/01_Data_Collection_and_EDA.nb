Cell[BoxData[{
 RowBox[{
  RowBox[{"logP", "=", 
   RowBox[{"Log", "[", 
    RowBox[{"close", "[", "\"\<Values\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Differences", "[", "logP", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rDates", "=", 
   RowBox[{"Rest", "[", "dates", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"returns", "=", 
    RowBox[{"TimeSeries", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"rDates", ",", "r"}], "}"}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "r", "]"}], "\n", 
 RowBox[{
  RowBox[{"{", 
