Cell[BoxData[{
 RowBox[{
  RowBox[{"nR", "=", 
   RowBox[{"Length", "[", "r", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rvFwd", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"t", "+", "1"}], ";;", 
           RowBox[{"t", "+", "5"}]}], "]"}], "]"}], "^", "2"}], "]"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "1", ",", 
       RowBox[{"nR", "-", "5"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rvFwdDates", "=", 
    RowBox[{"rDates", "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", 
       RowBox[{"nR", "-", "5"}]}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "rvFwd", "]"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"rvFwdDates", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", 
   RowBox[{"rDates", "[", 
    RowBox[{"[", 
     RowBox[{"2", ";;", "6"}], "]"}], "]"}]}], "}"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Last", "[", "rvFwdDates", "]"}], ",", 
    RowBox[{"rDates", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"nR", "-", "4"}], ";;", "nR"}], "]"}], "]"}]}], "}"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"rvFwd", "==", 
  RowBox[{"Rest", "[", "rv5", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"rvFwd", "-", 
     RowBox[{"Rest", "[", "rv5", "]"}]}], "]"}], "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"win", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DateObject", "[", 
      RowBox[{"{", 
       RowBox[{"2020", ",", "2", ",", "10"}], "}"}], "]"}], ",", 
     RowBox[{"DateObject", "[", 
      RowBox[{"{", 
       RowBox[{"2020", ",", "4", ",", "30"}], "}"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"pShift", "=", 
  RowBox[{"DateListPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TimeSeriesWindow", "[", 
       RowBox[{
        RowBox[{"TimeSeries", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"rv5Dates", ",", "rv5"}], "}"}], "]"}], "]"}], ",", 
        "win"}], "]"}], ",", 
      RowBox[{"TimeSeriesWindow", "[", 
       RowBox[{
        RowBox[{"TimeSeries", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"rvFwdDates", ",", "rvFwd"}], "}"}], "]"}], "]"}], ",", 
        "win"}], "]"}]}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{
      "\"\<Backward RV (feature side)\>\"", ",", 
       "\"\<Forward RV (target)\>\""}], "}"}]}], ",", 
