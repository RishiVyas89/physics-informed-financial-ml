}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "r", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pad", "[", 
     RowBox[{"k_", ",", "f_"}], "]"}], ":=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"Missing", "[", "\"\<WarmUp\>\"", "]"}], ",", 
        RowBox[{"k", "-", "1"}]}], "]"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"f", "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "k", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"absR", "=", 
   RowBox[{"Abs", "[", "r", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rv5", "=", 
   RowBox[{"pad", "[", 
    RowBox[{"5", ",", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"#", "-", "4"}], ";;", "#"}], "]"}], "]"}], "^", "2"}], 
        "]"}], "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rv22", "=", 
   RowBox[{"pad", "[", 
    RowBox[{"22", ",", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"#", "-", "21"}], ";;", "#"}], "]"}], "]"}], "^", "2"}], 
        "]"}], "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sig20", "=", 
    RowBox[{"pad", "[", 
     RowBox[{"20", ",", 
      RowBox[{
       RowBox[{"StandardDeviation", "[", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"#", "-", "19"}], ";;", "#"}], "]"}], "]"}], "]"}], 
       "&"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "/@", 
  RowBox[{"{", 
   RowBox[{"absR", ",", "rv5", ",", "rv22", ",", "sig20"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{"#", ",", "_Missing"}], "]"}], "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{"rv5", ",", "rv22", ",", "sig20"}], "}"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"rv5", "[", 
    RowBox[{"[", "5", "]"}], "]"}], ",", "0.00482945"}], "}"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"rv22", "[", 
    RowBox[{"[", "22", "]"}], "]"}], ",", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"r", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "22"}], "]"}], "]"}], "^", "2"}], "]"}], "]"}]}], 
  "}"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"sig20", "[", 
     RowBox[{"[", "20", "]"}], "]"}], ",", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "20"}], "]"}], "]"}], "-", 
          RowBox[{"Mean", "[", 
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "20"}], "]"}], "]"}], "]"}]}], ")"}], "^", 
        "2"}], "]"}], "/", "19"}], "]"}]}], "}"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"DeleteMissing", "[", "rv22", "]"}], "^", "2"}], "]"}], "/", 
     "22"}], "]"}], ",", 
   RowBox[{"StandardDeviation", "[", "r", "]"}]}], "}"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rDates", "[", 
     RowBox[{"[", 
      RowBox[{"First", "@", 
       RowBox[{"Ordering", "[", 
        RowBox[{
         RowBox[{"sig20", "/.", " ", 
          RowBox[{"_Missing", "->", "0"}]}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], ",", 
    RowBox[{"Max", "[", 
     RowBox[{"DeleteMissing", "[", "sig20", "]"}], "]"}]}], "}"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ts", "[", 
    RowBox[{"v_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"TimeSeries", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rDates", ",", 
         RowBox[{"v", "/", "s"}]}], "}"}], "]"}], ",", 
      RowBox[{
       RowBox[{"NumericQ", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"pVol", "=", 
  RowBox[{"DateListPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ts", "[", 
       RowBox[{"rv5", ",", 
        RowBox[{"Sqrt", "[", "5", "]"}]}], "]"}], ",", 
      RowBox[{"ts", "[", 
       RowBox[{"rv22", ",", 
        RowBox[{"Sqrt", "[", "22", "]"}]}], "]"}], ",", 
      RowBox[{"ts", "[", 
       RowBox[{"sig20", ",", "1"}], "]"}]}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{
      "\"\<RV5_past / sqrt(5)\>\"", ",", "\"\<RV22_past / sqrt(22)\>\"", ",", 
       "\"\<sigma20\>\""}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"ImageSize", "->", "Large"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Date\>\"", ",", "\"\<Volatility per day\>\""}], "}"}]}], 
    ",", 
    RowBox[{
    "PlotLabel", "->", 
     "\"\<Volatility features on a common per-day scale\>\""}]}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "projectDir", ",", "\"\<results\>\"", ",", "\"\<figures\>\"", ",", 
       "\"\<07_volatility_features.png\>\""}], "}"}], "]"}], ",", "pVol"}], 
   "]"}], ";"}]}], "Input",
