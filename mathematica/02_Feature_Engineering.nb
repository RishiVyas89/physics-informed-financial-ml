Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"projectDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "$HomeDirectory", ",", "\"\<Documents\>\"", ",", 
      "\"\<physics-informed-financial-ml\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"raw", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "projectDir", ",", "\"\<data\>\"", ",", "\"\<raw\>\"", ",", 
        "\"\<SP500_2011_2026.csv\>\""}], "}"}], "]"}], ",", "\"\<CSV\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Rest", "[", "raw", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dates", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"DateObject", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<Year\>\"", ",", "\"\<-\>\"", ",", "\"\<Month\>\"", ",", 
           "\"\<-\>\"", ",", "\"\<Day\>\""}], "}"}]}], "}"}], ",", 
       "\"\<Day\>\""}], "]"}], "&"}], "/@", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"closeP", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "5"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Differences", "[", 
    RowBox[{"Log", "[", "closeP", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rDates", "=", 
    RowBox[{"Rest", "[", "dates", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "closeP", "]"}], ",", 
   RowBox[{"Length", "[", "r", "]"}], ",", 
   RowBox[{"First", "[", "rDates", "]"}], ",", 
   RowBox[{"Last", "[", "rDates", "]"}]}], "}"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"r", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", 
   RowBox[{"Mean", "[", "r", "]"}], ",", 
   RowBox[{"StandardDeviation", "[", "r", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{4.0007232510302305`*^9, 4.000723251032234*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"3c01b3a9-4377-4675-8e36-ba6d948bb5d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3772", ",", "3771", ",", 
   TemplateBox[{
     RowBox[{"\"Mon 4 Apr 2011\""}], 
     RowBox[{"DateObject", "[", 
       RowBox[{
         RowBox[{"{", 
           RowBox[{"2011", ",", "4", ",", "4"}], "}"}], ",", "\"Day\""}], 
       "]"}]},
    "DateObject",
    Editable->False], ",", 
   TemplateBox[{
     RowBox[{"\"Wed 1 Apr 2026\""}], 
