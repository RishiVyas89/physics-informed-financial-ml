Cell[BoxData[{
 RowBox[{
  RowBox[{"rLag1", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Missing", "[", "\"\<WarmUp\>\"", "]"}], "}"}], ",", 
     RowBox[{"Most", "[", "r", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rLag2", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Missing", "[", "\"\<WarmUp\>\"", "]"}], ",", "2"}], "]"}], 
     ",", 
     RowBox[{"Drop", "[", 
      RowBox[{"r", ",", 
       RowBox[{"-", "2"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"m10", "=", 
    RowBox[{"pad", "[", 
     RowBox[{"10", ",", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"#", "-", "9"}], ";;", "#"}], "]"}], "]"}], "]"}], "&"}]}],
      "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "/@", 
  RowBox[{"{", 
   RowBox[{"rLag1", ",", "rLag2", ",", "m10"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{"#", ",", "_Missing"}], "]"}], "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{"rLag1", ",", "rLag2", ",", "m10"}], "}"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"rDates", "[", 
    RowBox[{"[", "100", "]"}], "]"}], ",", 
   RowBox[{"rLag1", "[", 
    RowBox[{"[", "100", "]"}], "]"}], ",", 
   RowBox[{"rDates", "[", 
    RowBox[{"[", "99", "]"}], "]"}], ",", 
   RowBox[{"r", "[", 
    RowBox[{"[", "99", "]"}], "]"}]}], "}"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rDates", "[", 
     RowBox[{"[", "100", "]"}], "]"}], ",", 
    RowBox[{"rLag2", "[", 
     RowBox[{"[", "100", "]"}], "]"}], ",", 
    RowBox[{"rDates", "[", 
     RowBox[{"[", "98", "]"}], "]"}], ",", 
    RowBox[{"r", "[", 
     RowBox[{"[", "98", "]"}], "]"}]}], "}"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"m10", "[", 
    RowBox[{"[", "10", "]"}], "]"}], ",", 
   RowBox[{"Log", "[", 
    RowBox[{
     RowBox[{"closeP", "[", 
      RowBox[{"[", "11", "]"}], "]"}], "/", 
     RowBox[{"closeP", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "}"}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"DeleteMissing", "[", "m10", "]"}], "-", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"closeP", "[", 
          RowBox[{"[", 
           RowBox[{"t", "+", "1"}], "]"}], "]"}], "/", 
         RowBox[{"closeP", "[", 
          RowBox[{"[", 
           RowBox[{"t", "-", "9"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "10", ",", "n"}], "}"}]}], "]"}]}], "]"}], "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rDates", "[", 
     RowBox[{"[", 
      RowBox[{"First", "@", 
       RowBox[{"Ordering", "[", 
        RowBox[{
         RowBox[{"m10", "/.", " ", 
          RowBox[{"_Missing", "->", "0"}]}], ",", "1"}], "]"}]}], "]"}], 
     "]"}], ",", 
    RowBox[{"Min", "[", 
     RowBox[{"DeleteMissing", "[", "m10", "]"}], "]"}]}], "}"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"pMom", "=", 
  RowBox[{"DateListPlot", "[", 
   RowBox[{
    RowBox[{"ts", "[", 
     RowBox[{"m10", ",", "1"}], "]"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"ImageSize", "->", "Large"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Date\>\"", ",", "\"\<10-day log return\>\""}], "}"}]}], 
    ",", 
    RowBox[{
    "PlotLabel", "->", "\"\<Momentum M10 = ln(P_t / P_(t-10))\>\""}]}], 
   "]"}]}], "\n", 
 RowBox[{
